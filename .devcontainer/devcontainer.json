{
  "name": "VeriCOBOL (Python 3.12 + GnuCOBOL)",
  "build": {
    "dockerfile": "../backend/Dockerfile",
    "context": "../backend"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/vericobol,type=bind",
  "workspaceFolder": "/workspaces/vericobol",
  "overrideCommand": true,
  "containerEnv": {
    "COBC_PATH": "cobc"
  },
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r backend/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
